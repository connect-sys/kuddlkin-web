{
  "name": "kuddlkin-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:customer": "turbo run dev --filter=kuddl-customer-web-new",
    "dev:partner": "turbo run dev --filter=partner-portal",
    "build:customer": "turbo run build --filter=kuddl-customer-web-new",
    "build:partner": "turbo run build --filter=partner-portal"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
